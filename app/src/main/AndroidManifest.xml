<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- GPS staff self-attendance (Phase 11): one-shot foreground location.
         FINE = precise fix; COARSE supports the Android 12 "approximate"
         path. No background location is requested. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- F13.1 Live GPS (2026-08-08): the bus position is streamed for the
         duration of a trip by a FOREGROUND service with a permanent,
         non-dismissible notification — the driver can always see that tracking
         is live, which is a privacy invariant of the feature.

         FOREGROUND_SERVICE_LOCATION is mandatory from Android 14 (API 34) for
         any service declaring foregroundServiceType="location".

         ACCESS_BACKGROUND_LOCATION is deliberately NOT requested: a foreground
         service with a visible notification covers the entire trip, so asking
         for background location would trigger Play's background-location review
         for no functional gain. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- No advertising / no Ad ID. Firebase Analytics (play-services-measurement)
         merges these Advertising-ID + Privacy-Sandbox attribution permissions by
         default; ZenXii uses none of them, so strip them from the merged manifest.
         Keeps the "no advertising SDKs / no Ad ID" statement in our Privacy Policy
         and the Play Data Safety form accurate. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <application
        android:name=".SchoolSyncApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SchoolSyncTeacher"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SchoolSyncTeacher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- F13.1 Live GPS trip tracking. Not exported: started only from
             within the app, after the canonical server lifecycle has confirmed
             the trip is InProgress. -->
        <service
            android:name=".data.location.TripTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="school_sync_channel" />

        <!-- Icon + tint used when FCM handles a notification-payload while the
             app is background/closed (system-tray path, no onMessageReceived). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_zenxii" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- Belt-and-suspenders: tell Firebase Analytics not to collect the
             Advertising ID at all (in addition to removing the permission above). -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- F14 QR attendance (2026-08-16) — pre-download the scanner module.
             GMS Code Scanner fetches its UI module from Play services on FIRST
             use. Without this, the first scan a conductor ever attempts needs a
             working connection, which on a bus at 6am is exactly when there
             isn't one. Declaring the dependency moves that download to install
             time. No CAMERA permission is required: Play services owns the
             camera, which is why this API was chosen over ML Kit + CameraX. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

    </application>
</manifest>
