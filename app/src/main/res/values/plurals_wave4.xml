    <plurals name="hw_del_submissions">
        <item quantity="one">%1$d submission</item>
        <item quantity="other">%1$d submissions</item>
    </plurals>
    <plurals name="hw_del_marks">
        <item quantity="one">%1$d mark</item>
        <item quantity="other">%1$d marks</item>
