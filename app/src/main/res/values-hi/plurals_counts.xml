<?xml version="1.0" encoding="utf-8"?>
<!-- Counted strings. "%d periods" reads wrong in the singular in
     Hindi, Tamil and Telugu, so these are <plurals>, resolved with
     pluralStringResource(id, quantity, quantity). -->
<resources>
    <plurals name="dashboard_periods_count">
        <item quantity="one">%1$d कालांश</item>
        <item quantity="other">%1$d कालांश</item>
    </plurals>
    <plurals name="story_cd_unseen">
        <item quantity="one">आपकी स्टोरी, %1$d अभी आपने नहीं देखी</item>
        <item quantity="other">आपकी स्टोरी, %1$d अभी आपने नहीं देखीं</item>
    </plurals>
    <plurals name="story_cd_posted">
        <item quantity="one">आपकी स्टोरी, %1$d पोस्ट की गई</item>
        <item quantity="other">आपकी स्टोरी, %1$d पोस्ट की गईं</item>
    </plurals>
</resources>
